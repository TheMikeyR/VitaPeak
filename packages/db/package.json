{
  "name": "@vitapeak/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "prisma"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "clean": "rm -rf dist .turbo",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "generate": "prisma generate --env-file ../../.env",
    "migrate": "prisma migrate dev --env-file ../../.env",
    "migrate:deploy": "prisma migrate deploy --env-file ../../.env",
    "studio": "prisma studio --env-file ../../.env",
    "format": "prisma format --env-file ../../.env"
  },
  "dependencies": {
    "@prisma/client": "^6.2.1"
  },
  "devDependencies": {
    "@vitapeak/config": "workspace:*",
    "prisma": "^6.2.1",
    "typescript": "^5.7.3"
  }
}
