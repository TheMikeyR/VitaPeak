{
  "name": "@vitapeak/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "clean": "rm -rf dist .turbo",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@ts-rest/core": "^3.51.0",
    "@vitapeak/validation": "workspace:*",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@vitapeak/config": "workspace:*",
    "typescript": "^5.7.3"
  }
}
