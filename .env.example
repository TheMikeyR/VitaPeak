# --- Database ---
POSTGRES_USER=vitapeak
POSTGRES_PASSWORD=vitapeak_dev
POSTGRES_DB=vitapeak
POSTGRES_PORT=5432
DATABASE_URL=postgresql://vitapeak:vitapeak_dev@localhost:5432/vitapeak?schema=public

# --- API ---
API_PORT=3001
NODE_ENV=development
LOG_LEVEL=debug

# --- Web ---
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3001

# --- MinIO (S3-compatible object storage) ---
MINIO_ROOT_USER=vitapeak
MINIO_ROOT_PASSWORD=vitapeak_dev
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET=vitapeak

# --- Redis (BullMQ queues, ready for chunk 06) ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- Mailhog (local SMTP capture; ADR 0004) ---
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025

# --- Mail provider (ADR 0004) ---
# console = stdout structured log (VPS default); smtp = local mailhog; postmark/resend = prod (chunk 06)
MAIL_PROVIDER=console
MAIL_FROM=no-reply@vitapeak.local
SMTP_HOST=localhost
SMTP_PORT=1025

# --- Auth (Better-Auth, chunk 01; ADR 0002) ---
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3001

# --- Observability (deferred — ADRs 0003, 0005) ---
# Sentry DSN unset on MVP VPS; setting it enables init at runtime
SENTRY_DSN=
