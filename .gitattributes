# Default: auto-detect text, normalize to LF in repo
* text=auto eol=lf

# Explicit text formats
*.md       text eol=lf
*.ts       text eol=lf
*.tsx      text eol=lf
*.js       text eol=lf
*.jsx      text eol=lf
*.json     text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf
*.html     text eol=lf
*.css      text eol=lf
*.scss     text eol=lf
*.svg      text eol=lf
*.sh       text eol=lf
*.sql      text eol=lf
*.prisma   text eol=lf
*.env      text eol=lf
*.env.example text eol=lf
Dockerfile text eol=lf
Caddyfile  text eol=lf

# Windows-only files keep CRLF
*.bat      text eol=crlf
*.cmd      text eol=crlf
*.ps1      text eol=crlf

# Binaries
*.png      binary
*.jpg      binary
*.jpeg     binary
*.gif      binary
*.ico      binary
*.webp     binary
*.pdf      binary
*.zip      binary
*.gz       binary
*.tar      binary
*.mp4      binary
*.mov      binary
*.woff     binary
*.woff2    binary
*.ttf      binary
*.eot      binary
*.otf      binary
